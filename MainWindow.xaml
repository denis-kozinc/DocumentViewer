<Window x:Class="DocumentViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DocumentViewer"
        mc:Ignorable="d"
        Title="Document Viewer" Width="1200" Height="800" 
        WindowStartupLocation="CenterScreen" MinWidth="600" MinHeight="400"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel>
        <Grid DockPanel.Dock ="Top" Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" >
                <ui:Button Icon="{ui:SymbolIcon ZoomOut24}" Appearance="Transparent" Click="ZoomOut_OnClick" ToolTip="Zoom out (Ctrl + -)"/>
                <TextBlock x:Name="ZoomPercentText" Text="{Binding ElementName=ZoomTransform, Path=ScaleX, StringFormat={}{0:P0}}" 
                           TextAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                <ui:Button Icon="{ui:SymbolIcon ZoomIn24}" Appearance="Transparent" Click="ZoomIn_OnClick" ToolTip="Zoom in (Ctrl + +)"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button x:Name="PreviousButton" Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Transparent" Focusable="False" 
                           ToolTip="Previous document" Click="PreviousButton_OnClick" IsEnabled="False"/>
                <TextBlock x:Name="CurrentDocumentText" VerticalAlignment="Center" Margin="10,0" 
                           Width="150" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <ui:Button x:Name="NextButton" Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Transparent" Focusable="False" 
                           ToolTip="Next document" Click="NextButton_OnClick" IsEnabled="False"/>
                <ui:Button x:Name="DocumentListButton" Icon="{ui:SymbolIcon List24}" Appearance="Transparent"
                           ToolTip="Select document" Click="DocumentListButton_OnClick"/>
                <Popup x:Name="DocumentListPopup" PlacementTarget="{Binding ElementName=DocumentListButton}" 
                       Placement="Bottom" StaysOpen="False" IsOpen="False" Opened="DocumentListPopup_OnOpened">
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                        <ListBox x:Name="DocumentListBox" Width="250" MaxHeight="300"
                                 SelectionChanged="DocumentListBox_OnSelectionChanged" DisplayMemberPath="Label"/>
                    </Border>
                </Popup>
            </StackPanel>
            <TextBlock Grid.Column="2" x:Name="CurrentPageText"  VerticalAlignment="Center" 
                       HorizontalAlignment="Right" Margin="10,0"/>
        </Grid>

        <Grid>
            <ScrollViewer x:Name="PdfScrollViewer" ScrollChanged="PdfScrollViewer_OnScrollChanged"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                          PreviewMouseWheel="PdfScrollViewer_OnPreviewMouseWheel" Background="{DynamicResource ViewerBackgroundBrush}">
                <StackPanel x:Name="PagesPanel">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                    </StackPanel.LayoutTransform>
                </StackPanel>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox x:Name="StatusText" IsReadOnly="True" Background="Transparent" Visibility="Collapsed" 
                         FontSize="14" TextWrapping="Wrap" Margin="20">
                </TextBox>
                <Button x:Name="RetryButton" Content="Retry" Width="80" Click="RetryButton_OnClick" Visibility="Collapsed"/>
            </StackPanel>
            
        </Grid>
    </DockPanel>
</Window>
